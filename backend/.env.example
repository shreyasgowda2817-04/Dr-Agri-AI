# ============================================================================
# Dr Agri AI - Backend Environment Configuration Template
# ============================================================================

PROJECT_NAME="Dr Agri AI API"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=true
COOKIE_SAMESITE="none"
COOKIE_DOMAIN=""

# MongoDB Database
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="crop_disease_db"

# ============================================================================
# Google Gemini AI & Multi-Model Fallback Configuration
# ============================================================================
# Server-side API key only. NEVER expose to frontend or git commits.
GEMINI_API_KEY="your-gemini-api-key-here"

# Primary model identifier (must be an eligible free-tier model)
GEMINI_PRIMARY_MODEL="gemini-2.5-flash"

# Comma-separated fallback models in order of priority
GEMINI_FALLBACK_MODELS="gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-flash-8b"

# Quota, retry, and timeout budgets
GEMINI_MAX_ATTEMPTS=3
GEMINI_PER_ATTEMPT_TIMEOUT=20.0
GEMINI_TOTAL_TIMEOUT=45.0
GEMINI_COOLDOWN_SECONDS=60
GEMINI_TRANSIENT_COOLDOWN_SECONDS=15

# Optional internal ML microservice URL
ML_SERVICE_URL=""

# ============================================================================
# Third-Party Integrations
# ============================================================================
# Cloudinary (Media storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Weather (OpenWeatherMap)
OPENWEATHERMAP_API_KEY=""

# Payments (Razorpay)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# OAuth (Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:8000/api/v1/auth/google/callback"

# Email (SMTP)
EMAIL_SERVICE="gmail"
EMAIL_USER=""
EMAIL_PASS=""
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587

# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Client & Deployment
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"
NODE_ENV="development"
SKIP_EMAIL_VERIFY="true"
